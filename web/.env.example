# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The publishable key is safe in the browser (Row Level Security protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Your site's public address, used in sign-in email links.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" only after the Google provider is enabled in
# Supabase (Authentication → Providers). Leave unset to hide the button.
# NEXT_PUBLIC_GOOGLE_SIGNIN=on

# Never put the secret / service-role key in a NEXT_PUBLIC_ variable.
